rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Candidates collection
    match /candidates/{candidateId} {
      allow read: if true; // Public tracking by passport & trackingId
      allow write: if true; // Admin operations / Sync
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true; // Public jobs directory
      allow write: if true; // Admin operations
    }

    // Umrah Packages collection
    match /umrah_packages/{packageId} {
      allow read: if true; // Public packages
      allow write: if true; // Admin operations
    }

    // Umrah Bookings collection
    match /umrah_bookings/{bookingId} {
      allow read: if true;
      allow write: if true;
    }

    // Sub-Agent Partners collection
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    // Partner Payments & Ledger
    match /partner_payments/{paymentId} {
      allow read, write: if true;
    }
    match /partner_ledger/{ledgerId} {
      allow read, write: if true;
    }
    match /visa_batches/{batchId} {
      allow read, write: if true;
    }
    match /visas/{visaId} {
      allow read, write: if true;
    }

    // Agency Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
